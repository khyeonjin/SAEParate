# SAEParate - joint style-object unlearning (UnlearnCanvas, 20 objects x 50 styles).
# Every value can be overridden inline, e.g.
#   NUM_PROCESSES=4 RUN_NAME=my_joint_run bash bash/train_unlearning_joint.sh all
#   RUN_NAME=my_joint_run bash bash/train_unlearning_joint.sh resume
# The joint pipeline does not download checkpoints; run the object/style pipeline
# once (or place them under checkpoints/ manually) before using it.
# Values below are defaults: anything already set in the environment takes precedence.

# -------- Run --------
RUN_NAME="${RUN_NAME:-}"                    # empty -> joint_unlearning_<timestamp>_<rand>
RUN_NAMESPACE="${RUN_NAMESPACE:-}"

# -------- Environment --------
SETUP_VENV="${SETUP_VENV:-false}"
PYTHON_BIN="${PYTHON_BIN:-python}"
VENV_DIR="${VENV_DIR:-}"
REINSTALL_REQUIREMENTS="${REINSTALL_REQUIREMENTS:-false}"

# -------- Checkpoints --------
DOWNLOAD_CHECKPOINTS="${DOWNLOAD_CHECKPOINTS:-false}"
CHECKPOINTS_ROOT="${CHECKPOINTS_ROOT:-checkpoints}"
MODEL_NAME="${MODEL_NAME:-checkpoints/style50}"
CLASS_CKPT="${CLASS_CKPT:-checkpoints/cls_model/style50_cls.pth}"
THEME_CKPT="${THEME_CKPT:-checkpoints/cls_model/style50.pth}"

# -------- WandB --------
WANDB_PROJECT="${WANDB_PROJECT:-sae_stable-diffusion-v1-4}"
WANDB_MODE="${WANDB_MODE:-online}"            # online | offline | disabled

# -------- Distributed --------
NUM_PROCESSES="${NUM_PROCESSES:-1}"              # number of GPUs used by accelerate
TRAIN_PORT="${TRAIN_PORT:-29604}"
GATHER_PORT="${GATHER_PORT:-29605}"
SAMPLE_PORT="${SAMPLE_PORT:-29606}"
EVAL_PORT="${EVAL_PORT:-29607}"

# -------- Activation collection --------
HOOKPOINT="${HOOKPOINT:-unet.up_blocks.1.attentions.1}"
CROSS_ATTENTION_MAP_POSITION="${CROSS_ATTENTION_MAP_POSITION:-unet.up_blocks.1.attentions.1.transformer_blocks.0.attn2}"
COLLECT_ACTS="${COLLECT_ACTS:-true}"
MAX_NUM_EXAMPLES="${MAX_NUM_EXAMPLES:-10000}"
# DATASET_PATH=              # default: runs/joint_unlearning/<run>/activations/train_dataset

# -------- SAE training --------
SKIP_TRAIN_SAE="${SKIP_TRAIN_SAE:-false}"
# SAE_CHECKPOINT=            # set to reuse a trained SAE (dir containing <HOOKPOINT>/cfg.json)
EFFECTIVE_BATCH_SIZE="${EFFECTIVE_BATCH_SIZE:-131072}"
MICRO_ACC_STEPS="${MICRO_ACC_STEPS:-1}"
AUXK_ALPHA="${AUXK_ALPHA:-0.03125}"
EXPANSION_FACTOR="${EXPANSION_FACTOR:-16}"
K="${K:-64}"
MULTI_TOPK="${MULTI_TOPK:-false}"
NUM_WORKERS="${NUM_WORKERS:-16}"
WANDB_LOG_FREQUENCY="${WANDB_LOG_FREQUENCY:-100}"
NUM_EPOCHS="${NUM_EPOCHS:-40}"
DEAD_FEATURE_THRESHOLD="${DEAD_FEATURE_THRESHOLD:-10000000}"
LR="${LR:-4e-4}"
LR_SCHEDULER="${LR_SCHEDULER:-linear}"
LR_WARMUP_STEPS="${LR_WARMUP_STEPS:-0}"
BATCH_TOPK="${BATCH_TOPK:-true}"
USE_PRE_ENCODER_GELU="${USE_PRE_ENCODER_GELU:-true}"
SUPCON_WEIGHT="${SUPCON_WEIGHT:-1.0}"
SUPCON_FEATURE_SOURCE="${SUPCON_FEATURE_SOURCE:-preact}"
SUPCON_TEMPERATURE="${SUPCON_TEMPERATURE:-0.07}"
JOINT_SUPCON_STRONG_POS_WEIGHT="${JOINT_SUPCON_STRONG_POS_WEIGHT:-1.0}"
JOINT_SUPCON_HARD_NEG_WEIGHT="${JOINT_SUPCON_HARD_NEG_WEIGHT:-4.0}"

# -------- Latent gathering --------
SKIP_GATHER_LATENTS="${SKIP_GATHER_LATENTS:-false}"
# LATENTS_PATH=              # default: <run>/sae_activations/combination_latents_dict_<HOOKPOINT>.pkl
PROMPT_BATCH_SIZE="${PROMPT_BATCH_SIZE:-32}"
SAE_BATCH_SIZE="${SAE_BATCH_SIZE:-32}"

# -------- Unlearning --------
STEPS="${STEPS:-100}"
GUIDANCE_SCALE="${GUIDANCE_SCALE:-9.0}"
SWEEP_BATCH_SIZE="${SWEEP_BATCH_SIZE:-64}"
EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-64}"
RUN_SWEEP="${RUN_SWEEP:-true}"               # per-combination (percentile, multiplier) search -> joint_best_params.pth
PERCENTILES="${PERCENTILES:-[99.995, 99.99, 99.95]}"
MULTIPLIERS="${MULTIPLIERS:-[-11.0, -9.0, -7.0, -5.0, -3.0, -1.0]}"
# BEST_PARAMS_PATH=          # set to skip the sweep with precomputed per-combination params
SEED="${SEED:-188}"
