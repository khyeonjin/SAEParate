# SAEParate - object unlearning (UnlearnCanvas, 20 object classes).
# Every value can be overridden inline, e.g.
#   NUM_PROCESSES=4 RUN_NAME=my_object_run bash bash/train_unlearning_object.sh all
#   RUN_NAME=my_object_run bash bash/train_unlearning_object.sh resume
# Values below are defaults: anything already set in the environment takes precedence.

# -------- Run --------
MODE="${MODE:-all}"                     # setup | train | unlearn | viz | all | resume
RUN_NAME="${RUN_NAME:-}"                    # empty -> object_unlearning_<timestamp>_<rand>
RUN_NAMESPACE="${RUN_NAMESPACE:-}"

# -------- Environment --------
PYTHON_BIN="${PYTHON_BIN:-python}"
SETUP_VENV="${SETUP_VENV:-false}"             # true -> create .venvs/<RUN_NAME> and install requirements.txt
VENV_DIR="${VENV_DIR:-}"
REINSTALL_REQUIREMENTS="${REINSTALL_REQUIREMENTS:-false}"

# -------- Checkpoints (downloaded with gdown only if missing) --------
DOWNLOAD_CHECKPOINTS="${DOWNLOAD_CHECKPOINTS:-true}"
FORCE_DOWNLOAD_CHECKPOINTS="${FORCE_DOWNLOAD_CHECKPOINTS:-false}"
CHECKPOINTS_ROOT="${CHECKPOINTS_ROOT:-checkpoints}"
GDRIVE_CLASSIFIER_FOLDER_URL="${GDRIVE_CLASSIFIER_FOLDER_URL:-https://drive.google.com/drive/folders/1AoazlvDgWgc3bAyHDpqlafqltmn4vm61}"
GDRIVE_MODEL_FOLDER_URL="${GDRIVE_MODEL_FOLDER_URL:-https://drive.google.com/drive/folders/18x40pLBcfNFyxBWZBGncTjqJTs_75SLx}"
MODEL_LOCAL_DIR="${MODEL_LOCAL_DIR:-checkpoints/style50}"
CLASSIFIER_LOCAL_DIR="${CLASSIFIER_LOCAL_DIR:-checkpoints/cls_model}"
MODEL_NAME="${MODEL_NAME:-checkpoints/style50}"
STYLE_CKPT="${STYLE_CKPT:-checkpoints/cls_model/style50.pth}"
CLASS_CKPT="${CLASS_CKPT:-checkpoints/cls_model/style50_cls.pth}"

# -------- WandB --------
WANDB_PROJECT="${WANDB_PROJECT:-sae_stable-diffusion-v1-4}"
WANDB_ENTITY="${WANDB_ENTITY:-}"
WANDB_MODE="${WANDB_MODE:-online}"            # online | offline | disabled
WANDB_RUN_NAME="${WANDB_RUN_NAME:-}"

# -------- Activation collection --------
NUM_PROCESSES="${NUM_PROCESSES:-1}"              # number of GPUs used by accelerate
HOOKPOINT="${HOOKPOINT:-unet.up_blocks.1.attentions.1}"
COLLECT_ACTS="${COLLECT_ACTS:-true}"
MAX_NUM_EXAMPLES="${MAX_NUM_EXAMPLES:-10000}"
# DATASET_PATH=              # default: runs/object_unlearning/<run>/activations/train_dataset

# -------- SAE training --------
SKIP_TRAIN_SAE="${SKIP_TRAIN_SAE:-false}"
# SAE_CHECKPOINT=            # set to reuse a trained SAE (dir containing <HOOKPOINT>/cfg.json)
EFFECTIVE_BATCH_SIZE="${EFFECTIVE_BATCH_SIZE:-131072}"
MICRO_ACC_STEPS="${MICRO_ACC_STEPS:-1}"
AUXK_ALPHA="${AUXK_ALPHA:-0.03125}"
EXPANSION_FACTOR="${EXPANSION_FACTOR:-16}"
K="${K:-32}"
MULTI_TOPK="${MULTI_TOPK:-false}"
NUM_WORKERS="${NUM_WORKERS:-6}"
WANDB_LOG_FREQUENCY="${WANDB_LOG_FREQUENCY:-100}"
NUM_EPOCHS="${NUM_EPOCHS:-40}"
DEAD_FEATURE_THRESHOLD="${DEAD_FEATURE_THRESHOLD:-10000000}"
LR="${LR:-4e-4}"
LR_SCHEDULER="${LR_SCHEDULER:-linear}"
LR_WARMUP_STEPS="${LR_WARMUP_STEPS:-0}"
BATCH_TOPK="${BATCH_TOPK:-true}"
USE_PRE_ENCODER_GELU="${USE_PRE_ENCODER_GELU:-true}"
SUPCON_WEIGHT="${SUPCON_WEIGHT:-0.1}"
SUPCON_FEATURE_SOURCE="${SUPCON_FEATURE_SOURCE:-preact}"
SUPCON_USE_PATCH_MASK="${SUPCON_USE_PATCH_MASK:-true}"
SUPCON_PATCH_MASK_COLUMN="${SUPCON_PATCH_MASK_COLUMN:-supcon_patch_mask}"
SUPCON_PATCH_MASK_CLASS_COLUMN="${SUPCON_PATCH_MASK_CLASS_COLUMN:-supcon_patch_mask_class}"
SUPCON_PATCH_MASK_THEME_COLUMN="${SUPCON_PATCH_MASK_THEME_COLUMN:-supcon_patch_mask_theme}"
SUPCON_TEMPERATURE="${SUPCON_TEMPERATURE:-0.07}"
SUPCON_MULTI_VIEW="${SUPCON_MULTI_VIEW:-true}"
SUPCON_CONCEPT_TYPE="${SUPCON_CONCEPT_TYPE:-class}"    # class | theme
JOINT_SUPCON="${JOINT_SUPCON:-false}"
JOINT_SUPCON_STRONG_POS_WEIGHT="${JOINT_SUPCON_STRONG_POS_WEIGHT:-1.0}"

# -------- Unlearning --------
UNLEARN_TARGET="${UNLEARN_TARGET:-object}"        # object | style | both
RUN_SWEEP="${RUN_SWEEP:-true}"               # per-class (percentile, multiplier) search -> class_params.pth
PERCENTILES="${PERCENTILES:-[99.999,99.995,99.99]}"
MULTIPLIERS="${MULTIPLIERS:-[-5.0,-1.0,-0.5,-0.1]}"
# CLASS_PARAMS_PATH=         # set to skip the sweep with precomputed per-class params
STYLE_PERCENTILE="${STYLE_PERCENTILE:-99.999}"
STYLE_MULTIPLIER="${STYLE_MULTIPLIER:--1.0}"
SEED_SWEEP="${SEED_SWEEP:-188}"
SEED_SAMPLE="${SEED_SAMPLE:-188}"
GATHER_SEED="${GATHER_SEED:-188}"
STEPS="${STEPS:-100}"
TARGET_CLASS="${TARGET_CLASS:-}"                # empty -> all classes
RUN_CHECK_PARAMS="${RUN_CHECK_PARAMS:-true}"

# -------- Latent gathering / visualization --------
SKIP_GATHER_CLASS_LATENTS="${SKIP_GATHER_CLASS_LATENTS:-false}"
SKIP_GATHER_STYLE_LATENTS="${SKIP_GATHER_STYLE_LATENTS:-false}"
PROMPT_BATCH_SIZE="${PROMPT_BATCH_SIZE:-32}"
SAE_BATCH_SIZE="${SAE_BATCH_SIZE:-32}"
UMAP_DIM="${UMAP_DIM:-2}"
SPHERE_DIM="${SPHERE_DIM:-3}"
N_NEIGHBORS="${N_NEIGHBORS:-15}"
MIN_DIST="${MIN_DIST:-0.1}"
MAX_PER_CLASS="${MAX_PER_CLASS:-400}"
SKM_K="${SKM_K:-32}"
SKM_MAX_ITER="${SKM_MAX_ITER:-50}"
SKM_TOL="${SKM_TOL:-1e-6}"
TOP_FEATURES_PER_STYLE="${TOP_FEATURES_PER_STYLE:-32}"
FEATURE_SORT_KEY="${FEATURE_SORT_KEY:-strength_sum_abs_act}"
CORE_THRESHOLD="${CORE_THRESHOLD:-0.6}"
SUPPORT_THRESHOLD="${SUPPORT_THRESHOLD:-0.2}"
IMPORTANCE_PERCENTILE="${IMPORTANCE_PERCENTILE:-95}"
IMPORTANCE_PLOT_TOPK="${IMPORTANCE_PLOT_TOPK:-200}"
SAVE_IMPORTANCE_PLOTS="${SAVE_IMPORTANCE_PLOTS:-false}"
